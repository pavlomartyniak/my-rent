PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=my-rent
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true

# Оплата публікації авто через WayForPay (https://wayforpay.com, кабінет мерчанта: ідентифікатор, секретний ключ і домен
# магазину). Без цих трьох змінних оплата працює лише при DEMO_MODE=true.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET=
WAYFORPAY_DOMAIN=
# Публічна адреса сервера для вебхука. На Render підставляється сама (RENDER_EXTERNAL_URL).
PUBLIC_API_URL=

# Cloudinary: завантаження фото авто (https://cloudinary.com/console, розділ API Keys).
# Без цих змінних фото лишаються лише на телефоні власника, а оголошення опублікувати не вдасться.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Листи (відновлення пароля): https://resend.com. Без ключа лист лише пишеться в журнал сервера.
RESEND_API_KEY=
MAIL_FROM=Kolo <no-reply@yourdomain.com>

# Нічне прибирання фото-сиріт у Cloudinary (завантажені понад добу тому й ніде не збережені).
# Вмикайте ТІЛЬКИ на проді, якщо dev і прод ділять одну хмару: база dev не знає про фото проду й видалила б їх.
# MEDIA_SWEEP=true
