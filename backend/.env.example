# Шаблон змінних середовища бекенду. Скопіюйте його в .env.development (локальна розробка) чи .env.production
# (локальний запуск проти проду; на Render змінні задаються в панелі). Обидва файли не потрапляють у git.
# Яке середовище вибрано, визначає APP_ENV: npm run start:dev → development, npm run start:local-prod → production.
# На Render APP_ENV не потрібен: сервер сам розпізнає Render.
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=my-rent
JWT_SECRET=change-me-to-a-long-random-string
# true лише на dev: дозволяє листам лише писатись у журнал сервера. На проді false або не задавати.
DEMO_MODE=true

# Куди надходять листи про нові скарги користувачів (за замовчуванням kolo.rentapp@gmail.com).
# MODERATION_EMAIL=

# Cloudinary: завантаження фото авто (https://cloudinary.com/console, розділ API Keys).
# Без цих змінних фото лишаються лише на телефоні власника, а оголошення опублікувати не вдасться.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Листи (відновлення пароля): https://resend.com. Без ключа лист лише пишеться в журнал сервера.
RESEND_API_KEY=
MAIL_FROM=Kolo <no-reply@yourdomain.com>

# Нічне прибирання фото-сиріт у Cloudinary (завантажені понад добу тому й ніде не збережені).
# Вмикайте ТІЛЬКИ на проді, якщо dev і прод ділять одну хмару: база dev не знає про фото проду й видалила б їх.
# MEDIA_SWEEP=true
