PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=my-rent
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true

# Cloudinary: завантаження фото авто (https://cloudinary.com/console, розділ API Keys).
# Без цих змінних фото лишаються лише на телефоні власника, а оголошення опублікувати не вдасться.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
